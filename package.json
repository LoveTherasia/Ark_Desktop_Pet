{
  "name": "ark-desktop-pet",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "ArkPet 桌宠 —— 0.7.0 起改用 Python + PySide6 + Spine C Runtime 实现",
  "scripts": {
    "py:build": "python build_runtime.py",
    "py:run": "python pet.py",
    "py:test": "python test_prototype.py",
    "legacy:dev": "vite --config legacy/vite.config.ts",
    "legacy:build": "vue-tsc -p legacy/tsconfig.json && vite build --config legacy/vite.config.ts && electron-builder --config legacy/electron-builder.json5",
    "legacy:preview": "vite preview --config legacy/vite.config.ts"
  },
  "dependencies": {
    "pixi-spine": "^3.1.2",
    "pixi.js": "^6.5.10",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vue-tsc": "^2.0.26"
  },
  "main": "legacy/dist-electron/main.js"
}
